# Pooled connection string (Neon: "Connection pooling" on)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Direct connection string, used by migrations (Neon: "Connection pooling" off)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# First doctor/admin account, created by `npm run db:seed`
ADMIN_NAME="NephChat Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
